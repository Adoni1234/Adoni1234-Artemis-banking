@using ArtemisBanking.Core.Application.Dtos.Beneficiary
@using ArtemisBanking.Core.Application.Dtos.SavingAccount

@{
    Layout = "~/Areas/Client/Views/Shared/_LayoutClient.cshtml";

    var accounts = ViewBag.Accounts as List<SavingAccountDto>;
    var beneficiaries = ViewBag.Beneficiaries as List<BeneficiaryDto>;
}

<style>
    .transfer-card {
        border-radius: 16px;
        border: none;
    }

    .form-label {
        font-size: 13px;
        color: #6c757d;
        margin-bottom: 6px;
    }

    .input-group-text {
        background: #fff;
        border-right: 0;
    }

    .form-control, .form-select {
        border-radius: 10px;
        padding: 10px;
    }

    .form-control:focus, .form-select:focus {
        border-color: #4e73df;
        box-shadow: 0 0 0 0.15rem rgba(78,115,223,0.15);
    }

    .btn-primary {
        background-color: #4e73df;
        border: none;
        border-radius: 10px;
        padding: 10px;
        font-weight: 500;
    }

    .btn-primary:hover {
        background-color: #3b5ed7;
    }
</style>

<div class="card transfer-card shadow-sm p-4">

    <!-- HEADER -->
    <h5 class="fw-bold text-primary mb-4">
        Transferencia de fondos
    </h5>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    @if (ViewBag.Success != null)
    {
        <div class="alert alert-success">@ViewBag.Success</div>
    }

    <form method="post" asp-action="Index">

        <!-- Cuenta origen -->
        <div class="mb-3">
            <label class="form-label">Cuenta origen</label>
            <div class="input-group">
                <span class="input-group-text">
                    <i class="bi bi-bank"></i>
                </span>
                <select name="FromAccountNumber" class="form-select" required>
                    @foreach (var acc in accounts ?? new List<SavingAccountDto>())
                    {
                        <option value="@acc.Id">
                            **** @acc.Id[^4..] | RD$ @acc.Balance.ToString("N2")
                        </option>
                    }
                </select>
            </div>
        </div>

        <!-- Beneficiario -->
        <div class="mb-3">
            <label class="form-label">Beneficiario</label>
            <div class="input-group">
                <span class="input-group-text">
                    <i class="bi bi-person"></i>
                </span>
                <select name="ToAccountNumber" class="form-select" required>
                    @foreach (var b in beneficiaries ?? new List<BeneficiaryDto>())
                    {
                        <option value="@b.SavingAccountId">
                            **** **** @b.SavingAccountId[^4..]
                        </option>
                    }
                </select>
            </div>
        </div>

        <!-- Monto -->
        <div class="mb-4">
            <label class="form-label">Monto</label>
            <div class="input-group">
                <span class="input-group-text">RD$</span>
                <input name="Amount" type="number" step="0.01" min="1"
                       class="form-control"
                       placeholder="Ingrese el monto" required />
            </div>
        </div>

        <!-- BOTÓN -->
        <button class="btn btn-primary w-100">
            Confirmar transferencia
        </button>

    </form>
</div>