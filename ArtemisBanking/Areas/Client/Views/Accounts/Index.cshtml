@model List<ArtemisBanking.Core.Application.Dtos.SavingAccount.SavingAccountDto>

@{
    ViewData["Title"] = "Mis cuentas";
    Layout = "~/Areas/Client/Views/Shared/_LayoutClient.cshtml";
}

<style>
    .account-card {
        border-radius: 20px;
        background: linear-gradient(135deg, #f8f9fc, #ffffff);
        transition: 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .account-card:hover {
        transform: translateY(-6px);
        box-shadow: 0px 15px 30px rgba(0,0,0,0.1);
    }

    .account-number {
        letter-spacing: 2px;
        color: #6c757d;
    }

    .balance {
        font-size: 1.8rem;
        font-weight: bold;
        color: #198754;
    }

    .badge-soft-primary {
        background: #e7f1ff;
        color: #0d6efd;
    }

    .badge-soft-success {
        background: #d1e7dd;
        color: #0f5132;
    }

    .badge-soft-danger {
        background: #f8d7da;
        color: #842029;
    }

    .btn-custom {
        border-radius: 10px;
        font-weight: 500;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">💳 Mis Cuentas</h2>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info shadow-sm">
        No tienes cuentas registradas.
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var account in Model)
        {
            <div class="col-md-4">
                <div class="card account-card shadow-sm h-100 border-0">

                    <div class="card-body d-flex flex-column">

                        <!-- Header -->
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="badge badge-soft-primary">
                                <i class="bi bi-credit-card"></i> Cuenta
                            </span>

                            @if (account.IsPrincipalAccount)
                            {
                                <span class="badge bg-primary">Principal</span>
                            }
                        </div>

                        <!-- Account Number -->
                        <h6 class="account-number mb-2">
                            **** **** **** @account.Id[^4..]
                        </h6>

                        <!-- Balance -->
                        <div class="balance mb-3">
                            RD$ @account.Balance.ToString("N2")
                        </div>

                        <!-- Status -->
                        <div class="mb-3">
                            <span class="badge @(account.IsActive ? "badge-soft-success" : "badge-soft-danger")">
                                @(account.IsActive ? "Activa" : "Inactiva")
                            </span>
                        </div>

                        <!-- Actions -->
                        <div class="d-flex gap-2 mt-auto">

                            <a asp-area="Client" asp-controller="Transactions" asp-action="History"
                               asp-route-accountNumber="@account.Id"
                               class="btn btn-outline-primary btn-custom w-100">
                                <i class="bi bi-clock-history"></i>
                            </a>

                            <a asp-area="Client" asp-controller="Transfer" asp-action="Index"
                               class="btn btn-primary btn-custom w-100">
                                <i class="bi bi-arrow-left-right"></i>
                            </a>

                        </div>

                    </div>
                </div>
            </div>
        }
    </div>
}