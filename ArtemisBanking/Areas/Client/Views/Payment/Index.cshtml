@using ArtemisBanking.Core.Application.Dtos.SavingAccount
@using ArtemisBanking.Core.Application.Dtos.CreditCard
@using ArtemisBanking.Core.Application.Dtos.Loan

@{
    Layout = "~/Areas/Client/Views/Shared/_LayoutClient.cshtml";

    var accounts = ViewBag.Accounts as List<SavingAccountDto>;
    var cards = ViewBag.Cards as List<CreditCardDto>;
    var loans = ViewBag.Loans as List<LoanDto>;
}

<style>
    .payment-card {
        border-radius: 20px;
        transition: 0.3s;
        border: none;
    }

    .payment-card:hover {
        transform: translateY(-5px);
        box-shadow: 0px 15px 30px rgba(0,0,0,0.1);
    }

    .input-modern {
        border-radius: 12px;
        padding: 12px;
    }

    .icon-input {
        background: white;
        border-right: 0;
    }

    .btn-modern {
        border-radius: 12px;
        font-weight: 500;
        padding: 10px;
    }
</style>

<div class="row g-4">

    <!-- 💳 TARJETA -->
    <div class="col-md-6">
        <div class="card payment-card shadow-sm p-4 h-100">

            <h5 class="fw-bold text-primary mb-3">
                <i class="bi bi-credit-card"></i> Pago de Tarjeta
            </h5>

            <form method="post" asp-action="PayCreditCard">

                <!-- Cuenta -->
                <div class="input-group mb-3">
                    <span class="input-group-text icon-input">
                        <i class="bi bi-bank"></i>
                    </span>
                    <select name="accountNumber" class="form-select input-modern" required>
                        @foreach (var acc in accounts ?? new())
                        {
                            <option value="@acc.Id">
                                **** @acc.Id[^4..] | Balance: RD$ @acc.Balance.ToString("N2")
                            </option>
                        }
                    </select>
                </div>

                <!-- Tarjeta -->
                <div class="input-group mb-3">
                    <span class="input-group-text icon-input">
                        <i class="bi bi-credit-card-2-front"></i>
                    </span>
                    <select name="cardNumber" class="form-select input-modern" required>
                        @foreach (var c in cards ?? new())
                        {
                            <option value="@c.CardNumber">
                                **** **** **** @c.CardNumber[^4..]
                            </option>
                        }
                    </select>
                </div>

                <!-- Monto -->
                <div class="input-group mb-3">
                    <span class="input-group-text icon-input">
                        RD$
                    </span>
                    <input name="amount" type="number" step="0.01"
                           class="form-control input-modern"
                           placeholder="Monto a pagar" required />
                </div>

                <button class="btn btn-primary btn-modern w-100">
                    Pagar tarjeta
                </button>
            </form>

        </div>
    </div>

    <!-- 🏦 PRÉSTAMO -->
    <div class="col-md-6">
        <div class="card payment-card shadow-sm p-4 h-100">

            <h5 class="fw-bold text-success mb-3">
                <i class="bi bi-cash-coin"></i> Pago de Préstamo
            </h5>

            <form method="post" asp-action="PayLoan">

                <!-- Cuenta -->
                <div class="input-group mb-3">
                    <span class="input-group-text icon-input">
                        <i class="bi bi-bank"></i>
                    </span>
                    <select name="accountNumber" class="form-select input-modern" required>
                        @foreach (var acc in accounts ?? new())
                        {
                            <option value="@acc.Id">
                                **** @acc.Id[^4..] | Balance: RD$ @acc.Balance.ToString("N2")
                            </option>
                        }
                    </select>
                </div>

                <!-- Préstamo -->
                <div class="input-group mb-3">
                    <span class="input-group-text icon-input">
                        <i class="bi bi-file-earmark-text"></i>
                    </span>
                    <select name="loanNumber" class="form-select input-modern" required>
                        @foreach (var l in loans ?? new())
                        {
                            <option value="@l.Id">
                                Préstamo #@l.Id
                            </option>
                        }
                    </select>
                </div>

                <!-- Monto -->
                <div class="input-group mb-3">
                    <span class="input-group-text icon-input">
                        RD$
                    </span>
                    <input name="amount" type="number" step="0.01"
                           class="form-control input-modern"
                           placeholder="Monto a pagar" required />
                </div>

                <button class="btn btn-success btn-modern w-100">
                    Pagar préstamo
                </button>
            </form>

        </div>
    </div>

</div>

<!-- 🔔 ALERTAS -->
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger mt-3 shadow-sm">
        <i class="bi bi-exclamation-triangle"></i> @ViewBag.Error
    </div>
}

@if (ViewBag.Success != null)
{
    <div class="alert alert-success mt-3 shadow-sm">
        <i class="bi bi-check-circle"></i> @ViewBag.Success
    </div>
}