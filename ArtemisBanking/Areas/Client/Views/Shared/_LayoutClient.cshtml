@using ArtemisBanking.Infrastructure.Identity.Entities
@using Microsoft.AspNetCore.Identity
@inject UserManager<AppUser> UserManager;

@{
    Layout = null;
    var user = await UserManager.GetUserAsync(User);
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Artemis Banking</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>

    <style>
        :root {
            --primary: #4e73df;
            --primary-light: #eef2ff;
            --text-muted: #6c757d;
            --bg-main: #f5f7fb;
        }

        body {
            background: var(--bg-main);
            font-family: 'Segoe UI', sans-serif;
        }

        /* ===== NAVBAR ===== */
        .top-header {
            height: 70px;
            background: white;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 25px;
            border-bottom: 1px solid #eaeaea;
            position: fixed;
            width: 100%;
            z-index: 1000;
        }

        .logo-section {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 600;
            font-size: 17px;
            color: var(--primary);
        }

        .logo-section i {
            font-size: 20px;
        }

        .user-section {
            display: flex;
            align-items: center;
            gap: 15px;
            color: var(--text-muted);
            font-size: 14px;
        }

        /* ===== SIDEBAR ===== */
        .sidebar {
            position: fixed;
            top: 70px;
            left: 0;
            width: 230px;
            height: 100%;
            background: white;
            border-right: 1px solid #eaeaea;
            padding-top: 15px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 20px;
            color: var(--text-muted);
            text-decoration: none;
            font-size: 14px;
            transition: 0.2s ease;
        }

        .nav-item i {
            font-size: 17px;
        }

        .nav-item:hover {
            background: var(--primary-light);
            color: var(--primary);
        }

        .nav-item.active {
            background: var(--primary-light);
            color: var(--primary);
            border-left: 3px solid var(--primary);
            font-weight: 500;
        }

        /* ===== CONTENIDO ===== */
        .main-content {
            margin-left: 230px;
            margin-top: 70px;
            padding: 25px;
        }

        /* ===== BOTONES ===== */
        .btn-outline-danger {
            border-radius: 8px;
            font-size: 13px;
        }
    </style>
</head>

<body>

    <!-- NAVBAR -->
    <nav class="top-header">
        <div class="logo-section">
            <i class="bi bi-bank"></i>
            Artemis Banking
        </div>

        <div class="user-section">
            <span>Bienvenido, <strong>@($"{user?.FirstName} {user?.LastName}")</strong></span>

            <a asp-area="" asp-controller="Login" asp-action="LogOut"
               class="btn btn-outline-danger btn-sm">
                Cerrar sesión
            </a>
        </div>
    </nav>

    <!-- SIDEBAR -->
    <div class="sidebar">

        <a asp-area="Client" asp-controller="Home" asp-action="Index"
           class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
            <i class="bi bi-house"></i> Inicio
        </a>

        <a asp-area="Client" asp-controller="Transfer" asp-action="Index"
           class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Transfer" ? "active" : "")">
            <i class="bi bi-arrow-left-right"></i> Transferencias
        </a>

        <a asp-area="Client" asp-controller="Transaction" asp-action="Index"
           class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Transaction" ? "active" : "")">
            <i class="bi bi-clock-history"></i> Historial
        </a>

        <a asp-area="Client" asp-controller="Accounts" asp-action="Index"
           class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Accounts" ? "active" : "")">
            <i class="bi bi-wallet2"></i> Mis cuentas
        </a>

        <a asp-area="Client" asp-controller="Beneficiary" asp-action="Index"
           class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Beneficiary" ? "active" : "")">
            <i class="bi bi-people"></i> Beneficiarios
        </a>

        <a asp-area="Client" asp-controller="Payment" asp-action="Index"
           class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Payment" ? "active" : "")">
            <i class="bi bi-cash-coin"></i> Pagos
        </a>

    </div>

    <!-- CONTENIDO -->
    <main class="main-content">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)

</body>
</html> 