@model ArtemisBanking.Core.Application.PaginatedData<ArtemisBanking.Core.Application.Dtos.Transaction.TransactionDto>

@{
    ViewData["Title"] = "Historial de Transacciones";
    Layout = "~/Areas/Client/Views/Shared/_LayoutClient.cshtml";
}

<style>
    .card {
        border-radius: 14px;
        border: none;
    }

    .table thead th {
        font-weight: 600;
        font-size: 13px;
        color: #6c757d;
        border-bottom: 1px solid #eaeaea;
    }

    .table tbody tr:hover {
        background-color: #f8f9fc;
    }

    .badge-soft {
        background-color: #eef2ff;
        color: #4e73df;
        padding: 5px 10px;
        border-radius: 8px;
        font-size: 12px;
    }

    .amount-positive {
        color: #198754;
        font-weight: 600;
    }

    .amount-negative {
        color: #dc3545;
        font-weight: 600;
    }

    .pagination span {
        font-size: 14px;
        color: #6c757d;
    }

    .btn {
        border-radius: 8px;
        font-size: 13px;
    }
</style>

<div class="container mt-4">
    <div class="card shadow-sm p-4">

        <h5 class="mb-4 text-primary fw-bold">
            Historial de transacciones
        </h5>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Tipo</th>
                        <th class="text-end">Monto</th>
                        <th>Origen</th>
                        <th>Destino</th>
                        <th class="text-center">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model?.Items != null && Model.Items.Any())
                    {
                        foreach (var item in Model.Items)
                        {
                            var isDebit = item.Type.ToString() == "Debit";

                            <tr>
                                <td>@item.Date.ToString("dd/MM/yyyy HH:mm")</td>

                                <td>
                                    <span class="badge-soft">
                                        @item.SubType
                                    </span>
                                </td>

                                <td class="text-end @(isDebit ? "amount-negative" : "amount-positive")">
                                    @(isDebit ? "-" : "+") @item.Amount.ToString("N2")
                                </td>

                                <td>@item.Origin</td>
                                <td>@item.Beneficiary</td>

                                <td class="text-center">
                                    <span class="badge bg-light text-dark">
                                        @item.Status
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted">
                                No hay transacciones
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- PAGINACIÓN -->
        <div class="d-flex justify-content-between mt-3 pagination">

            @if (Model.Pagination.CurrentPage > 1)
            {
                <a class="btn btn-outline-primary"
                   asp-route-page="@(Model.Pagination.CurrentPage - 1)"
                   asp-route-accountNumber="@ViewBag.AccountNumber">
                    Anterior
                </a>
            }
            else
            {
                <button class="btn btn-outline-secondary" disabled>Anterior</button>
            }

            <span class="align-self-center">
                Página @Model.Pagination.CurrentPage de @Model.Pagination.TotalPages
            </span>

            @if (Model.Pagination.CurrentPage < Model.Pagination.TotalPages)
            {
                <a class="btn btn-outline-primary"
                   asp-route-page="@(Model.Pagination.CurrentPage + 1)"
                   asp-route-accountNumber="@ViewBag.AccountNumber">
                    Siguiente
                </a>
            }
            else
            {
                <button class="btn btn-outline-secondary" disabled>Siguiente</button>
            }

        </div>

    </div>
</div>